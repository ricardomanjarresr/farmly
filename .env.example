# Copy this file to .env and fill in real values locally.
# Never commit .env - it's gitignored, and this repo is public.

# SQLite for local dev; swapped for a hosted Postgres URL before deploy.
DATABASE_URL="file:./dev.db"

# From @BotFather on Telegram. Server-side only - never expose to the
# client/browser. Needed to verify Telegram Login Widget callbacks and
# to send bot messages/notifications.
TELEGRAM_BOT_TOKEN=""

# From aistudio.google.com. Only needed for photo->listing extraction
# (telegram-farmer-backend branch) - not needed for the web/feed side.
GEMINI_API_KEY=""
